[Unit]
Description=Factory Lab funded world
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=factory
Group=factory
WorkingDirectory=/srv/factorylab
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/srv/factorylab/ops.env
RuntimeDirectory=factorylab
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/bin/bash /srv/factorylab/repo/deploy/start.sh
ExecStopPost=-/bin/bash /srv/factorylab/repo/deploy/alert.sh
Restart=always
RestartSec=30s
RestartSteps=6
RestartMaxDelaySec=15min
SuccessExitStatus=3
RestartPreventExitStatus=3
TimeoutStopSec=90s
KillMode=control-group
StandardOutput=null
StandardError=null
LimitCORE=0
# The runtime, its journal and every jailed tool call share these bounds: a
# population program (or a leak) that exhausts memory or forks without limit
# ends this unit, not the host the witness and the backups run on.
MemoryMax=3G
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# runs/ holds the diary, its key, the artifact archive and the income spool;
# .witness/ is where the runtime appends the kill line and start.sh appends
# launch and failed_resume lines (it is deliberately outside runs/, see
# deploy/README.md "Witness"). The provisioner creates both as factory.
ReadWritePaths=/srv/factorylab/runs /srv/factorylab/.witness

[Install]
WantedBy=multi-user.target
