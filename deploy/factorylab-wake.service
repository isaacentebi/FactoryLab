[Unit]
Description=Publish Factory Lab sealed wake
Wants=network-online.target
After=network-online.target
# A wake that fails or hangs past its timeout reaches the owner (deploy/alert.sh).
OnFailure=factorylab-alert@wake_failed.service
# The health verdict ages the ledger at the moment it checks (Chapter II §IV.c: the
# control apparatus is not slower than its environment), so it runs as each
# publication finishes, however long the wake took (Sol 6.1 r5).
OnSuccess=factorylab-health.service

[Service]
Type=oneshot
User=factory
Group=factory
WorkingDirectory=/srv/factorylab
EnvironmentFile=-/srv/factorylab/ops.env
ExecStart=/srv/factorylab/repo/.venv/bin/factorylab wake --ledger /srv/factorylab/runs/funded.jsonl --out /srv/factorylab/www
# The dormancy witness and the health verdict read this publication from their own
# unit, factorylab-health.service, so a wake that never publishes is seen there too.
UMask=0077
TimeoutStartSec=15min
StandardOutput=null
StandardError=null
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# www/ is the published wake (its pages included). runs/ and .witness/ were bound for
# the dormancy witness, which now runs in factorylab-health.service; narrowing them waits
# for a change that proves the wake itself writes nothing there.
ReadWritePaths=/srv/factorylab/www /srv/factorylab/runs /srv/factorylab/.witness
