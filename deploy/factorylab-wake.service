[Unit]
Description=Publish Factory Lab sealed wake
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=factory
Group=factory
WorkingDirectory=/srv/factorylab
EnvironmentFile=-/srv/factorylab/ops.env
ExecStart=/srv/factorylab/repo/.venv/bin/factorylab wake --ledger /srv/factorylab/runs/funded.jsonl --out /srv/factorylab/www
# After each publish, witness a change into or out of dormancy (deploy/witness_liveness.py);
# best effort, so a witness failure never fails the wake.
ExecStartPost=-/srv/factorylab/repo/.venv/bin/python /srv/factorylab/repo/deploy/witness_liveness.py --wake /srv/factorylab/www/wake.json --state /srv/factorylab/runs/funded.liveness
UMask=0077
TimeoutStartSec=15min
StandardOutput=null
StandardError=null
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# www/ is the published wake (its pages included), runs/ the liveness state file,
# .witness/ where witness_liveness.py's dormant lines are appended.
ReadWritePaths=/srv/factorylab/www /srv/factorylab/runs /srv/factorylab/.witness
