[Unit]
Description=Factory Lab health verdict after boot

[Timer]
# The hourly verdict runs from the wake unit (OnSuccess=), right after each finished
# publication: the ledger is aged at the check, and a check half an hour after the
# publish would read every fresh ledger as stale. This timer covers a boot whose wake
# failed; a wake that keeps failing is alerted by its own unit (wake_failed).
OnBootSec=10min
Persistent=true
Unit=factorylab-health.service

[Install]
WantedBy=timers.target
